# Flat list for easy iteration
ALL_QUERIES = []
for category, queries in PYTHON_TEST_QUERIES.items():
    ALL_QUERIES.extend(queries)

def get_queries_by_level(level="all"):
    """Get queries by difficulty level"""
    if level == "beginner":
        return [q for cat, queries in PYTHON_TEST_QUERIES.items() 
                if cat.startswith("BEGINNER") for q in queries]
    elif level == "intermediate":
        return [q for cat, queries in PYTHON_TEST_QUERIES.items() 
                if cat.startswith("INTERMEDIATE") for q in queries]
    elif level == "advanced":
        return [q for cat, queries in PYTHON_TEST_QUERIES.items() 
                if cat.startswith("ADVANCED") for q in queries]
    else:
        return ALL_QUERIES

def test_rag_with_python_queries():
    """Test RAG system with Python queries"""
    from rag_chain import create_rag_chain
    
    print("=" * 80)
    print("TESTING RAG WITH PYTHON DOCUMENTS")
    print("=" * 80)
    
    chain = create_rag_chain()
    
    # Test with different difficulty levels
    test_levels = {
        "BEGINNER": get_queries_by_level("beginner")[:5],
        "INTERMEDIATE": get_queries_by_level("intermediate")[:5],
        "ADVANCED": get_queries_by_level("advanced")[:5],
    }
    
    for level, queries in test_levels.items():
        print(f"\n{'='*80}")
        print(f"TESTING {level} LEVEL")
        print(f"{'='*80}\n")
        
        for i, query in enumerate(queries, 1):
            print(f"[{i}] Query: {query}")
            try:
                answer = chain.invoke(query)
                print(f"    Answer: {answer[:200]}...\n")
            except Exception as e:
                print(f"    Error: {e}\n")

