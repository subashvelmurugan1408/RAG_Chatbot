# ============================================================================
# .gitignore - Git Ignore File
# ============================================================================
# This file specifies which files and folders should NOT be committed to git
# 
# Add this file to your git repository to prevent committing:
# - Sensitive data (.env files)
# - Large files (node_modules, chroma_db)
# - Temporary files
# - Cache and build artifacts
# ============================================================================

# ============================================================================
# ENVIRONMENT & CONFIGURATION
# ============================================================================

# Environment variables (NEVER commit API keys!)
.env
.env.local
.env.*.local
.env.backup

# OS-specific files
.DS_Store
Thumbs.db
desktop.ini
.AppleDouble
.LSOverride

# ============================================================================
# PYTHON
# ============================================================================

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so

# C extensions
*.c
*.so

